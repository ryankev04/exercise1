// Redraws the whole menu: clears the screen, then lists every item,
// putting a ">" next to whichever one is currently highlighted.
static void menu_draw(menu_t *m, uint8_t selected)
{
	oled_clear();
	for (uint8_t i = 0; i < m->item_count; i++) {
